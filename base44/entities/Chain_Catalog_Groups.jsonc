{
  "name": "Chain_Catalog_Groups",
  "type": "object",
  "properties": {
    "catalog_group": {
      "type": "string",
      "description": "Group name"
    },
    "chain_family": {
      "type": "string",
      "description": "Matching chain_family"
    },
    "intro": {
      "type": "string",
      "description": "Customer introduction (1-3 sentences)"
    },
    "count": {
      "type": "number",
      "description": "Chains in group"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order"
    }
  },
  "required": [
    "catalog_group"
  ]
}