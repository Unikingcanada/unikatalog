{
  "name": "Normalized_Chains",
  "type": "object",
  "properties": {
    "chain_id": {
      "type": "string",
      "description": "Unique normalized chain identifier — e.g. ANSI-40, WH78, 667-PINTLE"
    },
    "chain_family": {
      "type": "string",
      "enum": [
        "Performance Roller Chains",
        "Conveyor Roller Chains",
        "Attachment Roller Chains",
        "Hollow Pin Chains",
        "Double Pitch Conveyor Chains",
        "Engineered Class Chains",
        "Welded Steel Chains",
        "Steel Pintle Chains",
        "Steel Bushed Chains",
        "Agricultural Conveyor Chains",
        "SharpTop Chains",
        "Forged Chains",
        "Drop Forged Rivetless Chains",
        "Overhead Conveyor Chains",
        "Drag / Scraper Chains",
        "Bucket Elevator Chains",
        "Leaf Chains",
        "Specialty / Custom Chains"
      ],
      "description": "Primary chain family for browsing and filtering"
    },
    "chain_number": {
      "type": "string",
      "description": "Standard chain number — e.g. 40, 80H, C2060H, WH78, 667"
    },
    "display_name": {
      "type": "string",
      "description": "Full normalized display name — e.g. ANSI 40 Roller Chain"
    },
    "standard": {
      "type": "string",
      "description": "Applicable standard — e.g. ANSI B29.1, ISO 606, DIN 8188"
    },
    "pitch_in": {
      "type": "string",
      "description": "Chain pitch in inches"
    },
    "pitch_mm": {
      "type": "string",
      "description": "Chain pitch in mm"
    },
    "strands": {
      "type": "number",
      "description": "Number of strands (1 = simplex, 2 = duplex, 3 = triplex)",
      "default": 1
    },
    "description": {
      "type": "string",
      "description": "Short normalized description of the chain"
    },
    "application_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Industry and application tags — e.g. Agriculture, Mining, Food Grade"
    },
    "materials_available": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Confirmed available materials / coatings — e.g. Carbon Steel, Stainless Steel, Nickel Plated"
    },
    "options_upgrades": {
      "type": "string",
      "description": "Available upgrades/options such as nickel plated, lambda, hardened pins, corrosion resistant, etc."
    },
    "image_url": {
      "type": "string",
      "description": "Primary chain product image URL"
    },
    "drawing_url": {
      "type": "string",
      "description": "Technical drawing or dimensional drawing URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Pending Review",
        "Discontinued",
        "On Request"
      ],
      "default": "Active",
      "description": "Catalog status"
    },
    "needs_review": {
      "type": "boolean",
      "default": false,
      "description": "Flag for Uniking engineering review"
    },
    "uniking_notes": {
      "type": "string",
      "description": "Internal Uniking notes, engineering comments, sourcing notes, or application guidance"
    },
    "catalog_group": {
      "type": "string",
      "description": "Website group (31 groups from the Version X master), e.g. Welded Steel Mill Chain"
    },
    "series": {
      "type": "string",
      "description": "Series line shown under the designation"
    },
    "construction": {
      "type": "string",
      "description": "Construction template, e.g. Welded Offset Sidebar"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other numbers that find this chain in search (old maker-coded names, interchanges). Search only, never displayed as brands."
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Evidence-based materials/finishes: {code,name,class,description}. Configurator offers only these + custom."
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Other catalogued versions {name,kind}"
    },
    "attachment_coverage": {
      "type": "string",
      "description": "Catalogued | Made to order | None by design"
    },
    "attachment_count": {
      "type": "number",
      "description": "Number of catalogue-evidenced attachments"
    },
    "image_match": {
      "type": "string",
      "description": "series | family | render — how closely the photo matches"
    },
    "drawing_title": {
      "type": "string",
      "description": "Reference drawing title"
    },
    "drawing_legend": {
      "type": "array",
      "items": {
        "type": "array"
      },
      "description": "[[letter, meaning]] for the reference drawing"
    }
  },
  "required": [
    "chain_id",
    "chain_family",
    "chain_number"
  ]
}